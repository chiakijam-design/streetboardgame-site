// Cloudflare Workers/Pages 統合形式 設定
// _worker.js と組み合わせて、リダイレクト+静的配信を制御する
{
  "name": "streetboardgame",
  "compatibility_date": "2025-01-01",
  "main": "./_worker.js",
  // Workers / Durable Objectsの例外ログを保存する。Invocation LogsはリクエストURLを含むため、
  // 遠隔プレイの権限クエリを保存しないよう無効化する。重大イベントはD1とWebhookへ全件記録する。
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "WATA_COST_GUARD_MODE": "enforce",
    "WATA_COST_STOP_OVERVIEW": "false",
    // Google AdSense: keep "false" until the review passes. Then set "true" and
    // the display ad unit IDs (digits) from the AdSense dashboard. See
    // docs/ADVERTISING_PLACEMENT_POLICY.md. Auto ads must stay OFF for this site.
    "ADSENSE_ENABLED": "false",
    "ADSENSE_SLOT_RESULT": "",
    "ADSENSE_SLOT_LIBRARY": "",
    "ADSENSE_SLOT_BEFORE_CREATE": "",
    "ADSENSE_SLOT_BOARD": ""
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // HTMLだけWorkerを先に通し、nonce付きCSPを適用する。JS・CSS・画像はAssetsの直配信を維持する。
    "run_worker_first": [
      "/",
      "/locale-pages/*",
      "/en", "/en/*",
      "/es", "/es/*", "/fr", "/fr/*", "/de", "/de/*", "/it", "/it/*",
      "/pt", "/pt/*", "/ru", "/ru/*", "/uk", "/uk/*", "/pl", "/pl/*",
      "/nl", "/nl/*", "/sv", "/sv/*", "/da", "/da/*", "/no", "/no/*",
      "/fi", "/fi/*", "/cs", "/cs/*", "/el", "/el/*", "/ro", "/ro/*",
      "/hu", "/hu/*", "/bg", "/bg/*", "/hr", "/hr/*", "/sk", "/sk/*",
      "/tr", "/tr/*", "/ar", "/ar/*", "/he", "/he/*", "/hi", "/hi/*",
      "/bn", "/bn/*", "/id", "/id/*", "/ms", "/ms/*", "/th", "/th/*",
      "/vi", "/vi/*", "/ko", "/ko/*", "/zh-Hans", "/zh-Hans/*", "/zh-Hant", "/zh-Hant/*",
      "/*.html",
      "/challenge", "/challenge/",
      "/live-challenge", "/live-challenge/*", "/live", "/live/*", "/live-guide",
      "/about", "/about/",
      "/product", "/product/",
      "/pricing", "/pricing/",
      "/live-ops", "/live-ops/",
      "/question-ops", "/question-ops/",
      "/terms", "/terms/",
      "/privacy", "/privacy/",
      "/legal", "/legal/",
      "/creator-terms", "/creator-terms/",
      "/refund-policy", "/refund-policy/",
      "/content-guidelines", "/content-guidelines/",
      "/minor-policy", "/minor-policy/"
    ]
  },
  "triggers": {
    // 期限切れのD1データ（部屋・回数制限・管理ログイン・お問い合わせ）を毎時削除する。
    "crons": ["17 * * * *"]
  },
  // LIVE was removed on 2026-11-15. The two Durable Object classes remain as
  // empty stubs (src/retired/durable-objects.js) so no delete-class migration
  // is needed; they answer 410 and are never called by the site.
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOM_COORDINATOR",
        "class_name": "LiveRoomCoordinator"
      },
      {
        "name": "LIVE_VOTE_SHARD",
        "class_name": "LiveVoteShard"
      }
    ]
  },
  "exports": {
    "LiveRoomCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "LiveVoteShard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "REMOTE_DB",
      "database_name": "streetboardgame-remote",
      "database_id": "3feb5dad-3465-4d1f-a12b-8859a28308f4"
    }
  ]
}
